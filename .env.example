# Provider: auto, openai, ollama or none
AURIX_LLM_PROVIDER=auto
OPENAI_API_KEY=
AURIX_OPENAI_MODEL=gpt-5-mini

# Local Ollama server and model
AURIX_OLLAMA_URL=http://localhost:11434
AURIX_OLLAMA_MODEL=llama3.2

# Speech transcription: google or vosk
# Google transcription sends the captured request audio to Google after wake-word activation.
AURIX_SPEECH_PROVIDER=google
AURIX_VOSK_MODEL_PATH=

# Wake-word detection threshold (0.0 to 1.0)
AURIX_WAKE_THRESHOLD=0.55
